# Optional. When set, cloudflared tunnel run starts and dials out.
# CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Default is the MetaQuotes Linux installer URL.
# A different URL also requires MT4_SETUP_SHA256.
# MT4_SETUP_URL=https://download.mql5.com/cdn/web/metaquotes.software.corp/mt4/mt4oldsetup.exe
# MT4_SETUP_SHA256=

# Set to 1 to allow an https installer host other than download.mql5.com.
# MT4_ALLOW_UNLISTED_SETUP_HOST=0
